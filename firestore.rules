rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /players/{playerId} {
      allow create, update: if signedIn()
        && request.auth.uid == playerId
        && request.resource.data.uid == request.auth.uid;
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /worlds/{worldId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow get, list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /ai_training/{eventId} {
      allow create: if signedIn()
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.worldId is string
        && request.resource.data.winner is string
        && request.resource.data.attacker is string
        && request.resource.data.defender is string;
      allow read, update, delete: if false;
    }

    match /global_champion/{championId} {
      allow read: if signedIn();
      // Champion writes must be performed by a trusted server process.
      allow write: if false;
    }

    // Shared public news data used by Web-TT. Anyone can read published
    // branches/articles; authenticated users can only modify their own data.
    match /news_branches/{branchId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /news_articles/{articleId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.branchId is string
        && request.resource.data.title is string;
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
    }
  }
}
