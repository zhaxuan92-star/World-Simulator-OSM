  "package_type": "world-simulator-game-release",
  "game": {
    "name": "World Simulator",
    "version": "2.1.4",
    "channel": "alpha",
    "build_label": "Alpha 2.1.4",
    "platforms": ["web", "android-browser"],
    "entry": "/",
    "repository": "https://github.com/zhaxuan92-star/World-Simulator-OSM"
